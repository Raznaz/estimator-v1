# Шаблон окружения прод-стека. На сервере копируется в /opt/estimator/.env.prod
# и заполняется реальными значениями. Сам .env.prod в git НЕ коммитится.
#
#   cp .env.prod.example .env.prod && nano .env.prod

# --- Домены -----------------------------------------------------------------
# Обслуживаются Caddy; на них должны быть A-записи, указывающие на IP сервера.
APP_DOMAIN=example.com, www.example.com
API_DOMAIN=api.example.com

# Origin'ы фронтенда для CORS бэкенда — через запятую, БЕЗ пробелов и со схемой.
CORS_ORIGIN=https://example.com,https://www.example.com

# --- Docker-образы ----------------------------------------------------------
# IMAGE_TAG подставляет деплой-workflow (короткий SHA коммита).
FRONTEND_IMAGE=ghcr.io/<github-username>/estimator-frontend
BACKEND_IMAGE=ghcr.io/<github-username>/estimator-backend
IMAGE_TAG=latest

# --- PostgreSQL -------------------------------------------------------------
# Пароль сгенерировать: openssl rand -base64 24
POSTGRES_USER=estimator
POSTGRES_PASSWORD=<сгенерировать>
POSTGRES_DB=estimator

# --- JWT --------------------------------------------------------------------
# Каждый секрет сгенерировать отдельно: openssl rand -base64 48
JWT_ACCESS_SECRET=<сгенерировать>
JWT_REFRESH_SECRET=<сгенерировать>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
